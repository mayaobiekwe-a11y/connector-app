# A Postgres connection string. For local dev, point this at a local
# Postgres instance or a free hosted one (e.g. Neon, Supabase). For
# deployment, see README.md's "Deploying" section.
DATABASE_URL="postgresql://user:password@localhost:5432/connector"

# Optional: without this, the app falls back to a deterministic keyword-based
# parser/matcher so the prototype still works without an API key.
ANTHROPIC_API_KEY=""

# Any random string; used to sign the session cookie.
SESSION_SECRET="change-this-to-a-random-32-character-string"

# Optional: without this, email notifications (new match, new message,
# accepted/declined, review received) are silently skipped and the app
# still fully works via in-app notifications only.
RESEND_API_KEY=""
# The "from" address emails are sent from. Needs a domain verified in Resend.
EMAIL_FROM="Mobi <notifications@themobiapp.com>"
# Base URL used to build links inside emails.
APP_URL="https://themobiapp.com"
