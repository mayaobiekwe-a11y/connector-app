// Data model for the referral-matching MVP.
// Designed so any community/network can run on the same schema —
// nothing here is hardcoded to a single group.
//
// Enum-like fields are plain Strings rather than native Prisma enums (this
// schema started on SQLite, which has no enum type, and there's no reason
// to reintroduce them now). The allowed values for each are defined as TS
// union types + validators in src/lib/enums.ts, the source of truth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A community/network instance the platform can host (e.g. "Acme Alumni",
// "DC Healthcare Founders"). Members, requests and matching are all scoped
// to a community so multiple trusted networks can share one deployment.
model Community {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  members  Member[]
  requests Request[]
}

// profileType: GENERAL | SERVICE_PROVIDER
// subscriptionStatus: NONE | ACTIVE | INACTIVE (only meaningful for SERVICE_PROVIDER;
// a status flag set manually for the prototype, no real billing integration)
model Member {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  title        String? // current role, e.g. "Product Manager"
  company      String?
  industry     String?
  location     String?
  bio          String?
  linkedinUrl  String? // optional; not required to join
  avatarUrl    String? // optional; a pasted image URL (no file upload in this prototype)
  isAdmin      Boolean  @default(false)
  // "Open to work" style signals used to match opportunity-style requests
  // (job openings / gig-hiring asks) against interested members.
  openToRoles   Boolean @default(false)
  openToGigWork Boolean @default(false)

  profileType        String  @default("GENERAL")
  subscriptionStatus String  @default("NONE")
  // How many open requests this member wants to take on per month. Null
  // means no self-imposed limit. Used to avoid overloading popular
  // connectors and to keep the responsiveness badge meaningful.
  monthlyCapacity Int?
  // Whether this member appears in the directory and the AI matching pool.
  // Off by default it'd defeat the point of joining, so it defaults to true;
  // members can opt out for privacy.
  visibleInDirectory Boolean @default(true)

  createdAt DateTime @default(now())

  communityId String
  community   Community @relation(fields: [communityId], references: [id])

  offerings     HelpOffering[]
  relationships Relationship[]
  sideHustles   SideHustle[]

  requestsMade    Request[]     @relation("RequestsMade")
  matches         Match[]       @relation("MatchesForMember")
  messages        Message[]
  reviewsGiven    Review[]      @relation("ReviewsGiven")
  reviewsReceived Review[]      @relation("ReviewsReceived")
  creditEntries   CreditEntry[]
  askCreditEntries AskCreditEntry[]

  @@index([communityId])
}

// What a member is willing to help with, and on what terms.
// category: INTRO_REFERRAL | RESUME_REVIEW | COFFEE_CHAT | MOCK_INTERVIEW | MENTORSHIP | PAID_CONSULTING
// compensation: FREE | BARTER | TIP | PAID
model HelpOffering {
  id           String   @id @default(cuid())
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id])
  category     String
  compensation String
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([memberId, category])
}

// A place a member has a solid personal relationship — not necessarily
// their own employer (e.g. a close friend at a company, a former team,
// a circle like "DC policy folks"). This is the strongest signal for
// warm-intro-style requests that name a specific company or industry,
// and is entirely optional / freeform so it fits any community.
model Relationship {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  label     String // e.g. "Google", "Meridian Health leadership", "DC policy circles"
  notes     String?
  createdAt DateTime @default(now())

  @@index([memberId])
}

// A business, passion project, or venture a member is building outside
// their day job. For a lot of members the day job pays the bills but the
// side hustle is what they actually want to be known for and want help
// advancing — so it's modeled and surfaced separately from title/company,
// not folded into the bio.
model SideHustle {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  name        String
  description String?
  url         String?
  createdAt   DateTime @default(now())

  @@index([memberId])
}

// The free-text "Ask" plus the structured fields an LLM extracts from it.
// status: OPEN | MATCHED | IN_PROGRESS | COMPLETED | CLOSED
// parsedIntent: SPECIFIC_ROLE | INFORMATIONAL_CHAT | EXPLORING_PIVOT | ONGOING_MENTOR | GENERAL_NETWORKING | BUSINESS_INTRO | SEEKING_GIG_WORK | HIRING_GIG_WORK | JOB_OPENING
model Request {
  id          String    @id @default(cuid())
  requesterId String
  requester   Member    @relation("RequestsMade", fields: [requesterId], references: [id])
  communityId String
  community   Community @relation(fields: [communityId], references: [id])

  rawText String
  status  String @default("OPEN")

  // --- structured fields parsed by Claude ---
  parsedCompany  String?
  parsedIndustry String?
  parsedFunction String?
  parsedIntent   String?
  parsedSummary  String? // short natural-language paraphrase for admin/UI
  parsedRaw      String? // full JSON response from the LLM, for the admin view
  parseError     String? // set if parsing failed and heuristic fallback was used

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches Match[]
  reviews Review[]

  @@index([communityId])
  @@index([requesterId])
}

// A member connected to a request — either AI-suggested (privately notified)
// or self-volunteered from the public community feed.
// status: PENDING | ACCEPTED | DECLINED | EXPIRED
// source: AI_MATCH | VOLUNTEER
model Match {
  id        String @id @default(cuid())
  requestId String
  request   Request @relation(fields: [requestId], references: [id])
  memberId  String
  member    Member  @relation("MatchesForMember", fields: [memberId], references: [id])

  rank        Int // 1 = best match; unused (0) for volunteer matches
  score       Float // 0-1 relevance score from the AI ranking; 1 for volunteers
  reason      String // natural-language explanation shown to the requester
  status      String    @default("PENDING")
  source      String    @default("AI_MATCH")
  respondedAt DateTime?

  createdAt DateTime @default(now())

  thread  Thread?
  reviews Review[]

  @@unique([requestId, memberId])
  @@index([memberId])
}

// Lightweight coordination thread created once a match is accepted.
model Thread {
  id        String    @id @default(cuid())
  matchId   String    @unique
  match     Match     @relation(fields: [matchId], references: [id])
  createdAt DateTime  @default(now())
  messages  Message[]
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id])
  senderId  String
  sender    Member   @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([threadId])
}

// The requester's report card on a match, once help was (or wasn't) given.
// outcome: HELPED | DIDNT_WORK_OUT | NO_RESPONSE
model Review {
  id         String @id @default(cuid())
  requestId  String
  request    Request @relation(fields: [requestId], references: [id])
  matchId    String
  match      Match   @relation(fields: [matchId], references: [id])
  reviewerId String
  reviewer   Member  @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   Member  @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  outcome String
  rating  Int? // 1-5, optional (e.g. omitted for NO_RESPONSE)
  comment String?

  createdAt DateTime @default(now())

  @@unique([matchId])
}

// Append-only points ledger. A member's total is the sum of their entries;
// badge tier is derived from the total (see src/lib/credit.ts).
// reason: RESPONDED_TO_REQUEST | COMPLETED_POSITIVE | COMPLETED_NEUTRAL | COMPLETED_LOW | DIDNT_WORK_OUT
model CreditEntry {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  points    Int
  reason    String
  refId     String? // e.g. the Match or Review id this entry is tied to
  createdAt DateTime @default(now())

  @@index([memberId])
}

// Append-only ledger for the *spendable* ask-credit balance — separate from
// CreditEntry's permanent reputation points. A member's balance is the sum
// of their entries; making a request costs credits so asking isn't
// unlimited, and helping (responding, being positively reviewed) earns more.
// reason: SIGNUP_BONUS | MONTHLY_REFRESH | ASK_SPENT | RESPONDED_TO_REQUEST | COMPLETED_POSITIVE
model AskCreditEntry {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  amount    Int // positive to earn, negative to spend
  reason    String
  refId     String? // e.g. the Request or Match id this entry is tied to
  createdAt DateTime @default(now())

  @@index([memberId])
}
